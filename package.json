{
  "name": "dsh-novelnovel",
  "version": "0.1.0",
  "description": "NovelNovel — DeepSeek Harness 插件：novel_* 工具、写作技能与 /novel 命令，用工作区文件写小说（章节/角色卡/世界观词条/写作预设/上下文组装/导出）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "wanrenhuifu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanrenhuifu/NovelNovel.git"
  },
  "homepage": "https://github.com/wanrenhuifu/NovelNovel#readme",
  "bugs": {
    "url": "https://github.com/wanrenhuifu/NovelNovel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "novel-writing",
    "webnovel",
    "fiction",
    "creative-writing",
    "chinese-novel",
    "sillytavern",
    "character-card"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "node scripts/test-card-import.mjs && node scripts/test-card-export.mjs && node scripts/test-preset-import.mjs && node scripts/test-search.mjs && node scripts/test-reorder.mjs && node scripts/test-skill-pack.mjs && node scripts/test-domain-utils.mjs && node scripts/test-client-normalize.mjs && node scripts/test-client-logic.mjs && node scripts/test-panel-render.mjs && node scripts/test-panel-interaction.mjs && node scripts/test-client-manifest.mjs && node scripts/test-client-bundle.mjs",
    "test:guard": "node scripts/test-harness-guard.mjs",
    "test:dsh": "node scripts/verify-dsh.mjs",
    "test:compose": "node scripts/verify-client-compose.mjs",
    "test:primitives": "node scripts/verify-client-primitives.mjs",
    "test:tokens": "node scripts/verify-client-tokens.mjs",
    "test:sandbox": "node scripts/verify-sandbox-session.mjs",
    "test:chapter-guard": "node scripts/verify-chapter-id-guard.mjs",
    "test:race": "node scripts/verify-concurrency.mjs",
    "test:edge": "node scripts/verify-edge-cases.mjs",
    "test:routes": "node scripts/verify-web-routes.mjs",
    "test:paging": "node scripts/verify-chapter-paging.mjs",
    "test:words": "node scripts/verify-word-cache.mjs",
    "test:render": "node scripts/test-panel-render.mjs",
    "test:interaction": "node scripts/test-panel-interaction.mjs",
    "test:contract": "node scripts/verify-doc-contract.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "test:perf": "node scripts/probe-dsh-perf.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@lenml/char-card-reader": "^1.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "jsdom": "25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
