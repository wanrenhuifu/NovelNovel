{
  "name": "novelnovel",
  "private": true,
  "version": "0.1.0",
  "description": "NovelNovel — AI 小说写作工作台：浏览器端 IDE（章节编辑 / 角色卡 / Lorebook / AI 续写）+ DeepSeek Harness 插件（dsh-plugin/）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "proxy": "node scripts/proxy.mjs",
    "build:plugin": "node dsh-plugin/build.mjs",
    "typecheck:plugin": "tsc -p dsh-plugin",
    "test": "node scripts/test-card-import.mjs && node scripts/test-iteration.mjs && node scripts/test-preset-import.mjs && node scripts/test-ai-retry.mjs && node scripts/test-search.mjs && node scripts/test-reorder.mjs && node scripts/test-crypto.mjs",
    "test:e2e": "playwright test",
    "test:dsh": "node scripts/verify-dsh.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lenml/char-card-reader": "^1.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
